---
import type { HTMLAttributes } from "astro/types"
import type { Align, Side } from "@data-slot/dropdown-menu"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  side?: Side
  align?: Align
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
}

const {
  class: className,
  hidden = true,
  side = "bottom",
  align = "start",
  sideOffset = 4,
  alignOffset = 0,
  avoidCollisions,
  collisionPadding,
  ...props
} = Astro.props
---

<div data-slot="dropdown-menu-portal">
  <div
    data-slot="dropdown-menu-positioner"
    data-side={side}
    data-align={align}
    data-side-offset={sideOffset}
    data-align-offset={alignOffset}
    data-avoid-collisions={avoidCollisions}
    data-collision-padding={collisionPadding}
    class="isolate z-50 outline-none"
  >
    <div
      data-slot="dropdown-menu-content"
      data-side={side}
      data-align={align}
      data-side-offset={sideOffset}
      data-align-offset={alignOffset}
      data-avoid-collisions={avoidCollisions}
      data-collision-padding={collisionPadding}
      hidden={hidden}
      class={cn(
        "relative isolate bg-popover dark:bg-background text-popover-foreground ring-foreground/10 data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95 data-open:animate-in data-open:fade-in-0 data-open:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=inline-end]:slide-in-from-left-2 data-[side=inline-start]:slide-in-from-right-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 z-50 flex flex-col max-h-(--available-height) w-(--anchor-width) min-w-32 origin-(--transform-origin) overflow-x-hidden rounded-[16px] p-[10px] shadow-md ring-1 duration-100 data-closed:overflow-hidden",
        className
      )}
      {...props}
    >
      <div class="scroll-inner overflow-y-auto overflow-x-hidden flex-1 min-h-0">
        <slot />
      </div>
      <div class="pointer-events-none absolute inset-0 rounded-[16px] border-[10px] border-background z-10"></div>
    </div>
  </div>
</div>

<style is:global>
  [data-slot="dropdown-menu-content"] [data-slot="dropdown-menu-item"]:first-child {
    margin-top: 2px;
  }

  [data-slot="dropdown-menu-content"] [data-slot="dropdown-menu-item"]:last-child {
    margin-bottom: 2px;
  }

  [data-slot="dropdown-menu-content"] .scroll-inner {
    scrollbar-color: var(--ring) var(--background);
    scrollbar-width: thin;
  }

  [data-slot="dropdown-menu-content"] .scroll-inner::-webkit-scrollbar {
    width: 6px;
  }

  [data-slot="dropdown-menu-content"] .scroll-inner::-webkit-scrollbar-track {
    background: var(--background);
  }

  [data-slot="dropdown-menu-content"] .scroll-inner::-webkit-scrollbar-thumb {
    background-color: var(--ring);
    border-radius: 3px;
  }
</style>
