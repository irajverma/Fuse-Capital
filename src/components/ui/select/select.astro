---
import type { HTMLAttributes } from "astro/types"
import type { Align, Position, Side } from "@data-slot/select"

import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div"> & {
  defaultValue?: string
  placeholder?: string
  disabled?: boolean
  required?: boolean
  name?: string
  position?: Position
  side?: Side
  align?: Align
  sideOffset?: number
  alignOffset?: number
  avoidCollisions?: boolean
  collisionPadding?: number
  highlightItemOnHover?: boolean
  /** Set to false to prevent body scroll locking when the dropdown opens.
   *  Useful when the page layout already handles overflow internally,
   *  since lock-scroll adds scrollbar compensation that shifts the page. */
  lockScroll?: boolean
}

const {
  class: className,
  defaultValue,
  placeholder,
  disabled,
  required,
  name,
  position,
  side,
  align,
  sideOffset,
  alignOffset,
  avoidCollisions,
  collisionPadding,
  highlightItemOnHover,
  lockScroll,
  ...props
} = Astro.props
---

<div
  data-slot="select"
  data-default-value={defaultValue}
  data-placeholder={placeholder}
  data-disabled={disabled}
  data-required={required}
  data-name={name}
  data-position={position}
  data-side={side}
  data-align={align}
  data-side-offset={sideOffset}
  data-align-offset={alignOffset}
  data-avoid-collisions={avoidCollisions}
  data-collision-padding={collisionPadding}
  data-highlight-item-on-hover={highlightItemOnHover}
  data-lock-scroll={lockScroll}
  class={cn(
    "group/select relative inline-flex w-fit flex-col gap-1.5",
    className
  )}
  {...props}
>
  <slot />
</div>

<script>
  import { create } from "@data-slot/select"

  // A Select's dropdown portals its positioner out to <body>, where it defaults to z-50. Any
  // Dialog's content sits at z-index calc(stack-index + 101) (dialog-content.astro), so a Select
  // rendered inside a Dialog would open its dropdown BEHIND the dialog: clicking the trigger looks
  // like nothing happened. Detected here structurally (the select root itself never moves, only
  // its positioner gets portaled) so it's automatic for every Select-in-Dialog, not something each
  // call site has to remember to opt into. Selects outside a dialog are left untouched.
  const markDialogSelects = () => {
    document.querySelectorAll('[data-slot="select"]').forEach((root) => {
      if (!root.closest('[data-slot="dialog-content"]')) return
      // Read before create() portals the positioner elsewhere; the class travels with the node.
      root.querySelector('[data-slot="select-positioner"]')?.classList.add("select-positioner-in-dialog")
    })
  }

  const initSelect = () => {
    markDialogSelects()
    create()
  }

  initSelect()

  document.addEventListener("astro:page-load", initSelect)
</script>

<style is:global>
  .select-positioner-in-dialog {
    z-index: 200;
  }
</style>
