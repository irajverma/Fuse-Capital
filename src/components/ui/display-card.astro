---
import { cn } from "@/lib/utils";
import { Icon } from "@/components/ui/icon";

interface Props {
  class?: string;
  title?: string;
  description?: string;
  date?: string;
}

const {
  class: className,
  title = "Featured",
  description = "Discover amazing content",
  date = "Just now",
} = Astro.props;
---

<div
  class={cn(
    "relative flex h-36 w-[22rem] -skew-y-[6deg] select-none flex-col justify-between rounded-xl border border-border bg-card p-4 transition-all duration-300 shadow-md hover:border-primary/40",
    "[&>*]:relative [&>*]:z-10",
    className
  )}
>
  <div class="flex items-center gap-2">
    <Icon name="sparkles" class="size-4 text-primary shrink-0" />
    <p class="text-base font-semibold text-foreground">{title}</p>
  </div>
  <p class="text-sm text-muted-foreground">{description}</p>
  <p class="text-xs font-mono text-muted-foreground">{date}</p>
</div>
