---
import { cn } from "@/lib/utils";
import Sparkles from "@lucide/astro/icons/sparkles";

interface Props {
  class?: string;
  title?: string;
  description?: string;
  date?: string;
}

const {
  class: className,
  title = "Featured",
  description = "Discover amazing content",
  date = "Just now",
} = Astro.props;
---

<div
  class={cn(
    "relative flex h-36 w-[22rem] -skew-y-[8deg] select-none flex-col justify-between rounded-xl border-2 border-white/10 backdrop-blur-sm px-4 py-3 transition-all duration-700",
    "before:absolute before:inset-0 before:rounded-xl before:bg-gradient-to-r before:from-slate-900 before:to-transparent before:transition-opacity before:duration-700 before:content-['']",
    "hover:border-white/20",
    "[&>*]:relative [&>*]:z-10 [&>*]:flex [&>*]:items-center [&>*]:gap-2",
    className
  )}
>
  <div>
    <span class="relative inline-block rounded-full bg-blue-800 p-1">
      <Sparkles class="size-4 text-blue-300" />
    </span>
    <p class="text-lg font-medium text-blue-500">{title}</p>
  </div>
  <p class="whitespace-nowrap text-lg">{description}</p>
  <p class="text-muted-foreground">{date}</p>
</div>
