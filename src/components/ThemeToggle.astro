---
import { cn } from '@/lib/utils'

type Props = { class?: string }
const { class: className } = Astro.props
---

<button
  data-theme-toggle
  aria-label="Toggle theme"
  class={cn(
    "inline-flex items-center justify-center rounded-md p-2 text-foreground hover:bg-secondary transition-colors cursor-pointer",
    className
  )}
>
  <!-- Sun icon (visible in dark mode) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden dark:block"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  <!-- Moon icon (visible in light mode) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="block dark:hidden"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>

<script>
  // A page can render more than one toggle (e.g. nav + footer). Bind them all,
  // and since the sun/moon icons are driven purely by the `.dark` class they
  // all stay in sync automatically when any one is clicked.
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });
</script>
