---
import { getImage } from 'astro:assets';
import IndustryIcon from '@/components/IndustryIcon.astro';
import { categoryIconColor, type Industry, type IndustryCategoryColor } from '@/data/industries';
import { getIndustryImage } from '@/data/industry-images';

type Props = {
  item: Industry;
  categoryKey: string;
  color: IndustryCategoryColor;
};

const { item, categoryKey, color } = Astro.props;

const cardImage = getIndustryImage(item.slug, categoryKey);
const optimizedCardImage = await getImage({ src: cardImage, format: 'webp', width: 600, height: 350 });
---

<a
  href={`/industries/${item.slug}`}
  data-card
  data-name={item.name.toLowerCase()}
  data-cat={categoryKey}
  class="group flex flex-col overflow-hidden bg-card border border-border/80 rounded-xl no-underline hover:border-primary/50 transition-all duration-300 hover:shadow-md"
>
  <div class="relative h-32 w-full overflow-hidden bg-muted">
    <img
      src={optimizedCardImage.src}
      alt={item.name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/25"></div>
    <div class="absolute bottom-3 left-3 flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-background/90 backdrop-blur-xs flex items-center justify-center shrink-0 border border-border/50 shadow-xs">
        <IndustryIcon item={item} class={`size-4 ${categoryIconColor[color]}`} />
      </div>
    </div>
  </div>

  <div class="p-4 flex flex-col justify-between flex-1">
    <div>
      <h3 class="text-base font-semibold text-foreground tracking-tight group-hover:text-primary transition-colors">
        {item.name}
      </h3>
      <p class="text-xs text-muted-foreground mt-1 line-clamp-1 font-mono tabular-nums">
        Up to $500k · 24h approval
      </p>
    </div>
    <div class="mt-4 pt-3 border-t border-border/50 flex items-center justify-between text-[11px] font-mono font-medium text-muted-foreground group-hover:text-primary transition-colors">
      <span>View Program Spec</span>
    </div>
  </div>
</a>

