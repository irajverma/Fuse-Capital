---
import IndustryIcon from '@/components/IndustryIcon.astro';
import { categoryBannerColor, categoryIconColor, type Industry, type IndustryCategoryColor } from '@/data/industries';

type Props = {
  item: Industry;
  categoryKey: string;
  color: IndustryCategoryColor;
};

const { item, categoryKey, color } = Astro.props;
---

<a
  href={`/industries/${item.slug}`}
  data-card
  data-name={item.name.toLowerCase()}
  data-cat={categoryKey}
  class="flex flex-col bg-card border border-border rounded-2xl overflow-hidden no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <span class:list={['relative overflow-hidden h-24 flex items-center px-4 bg-gradient-to-br', categoryBannerColor[color]]}>
    <IndustryIcon item={item} size={92} strokeWidth={1.4} class={`absolute -right-3.5 -bottom-4.5 opacity-15 ${categoryIconColor[color]}`} />
    <span class="w-13 h-13 rounded-2xl bg-white/80 dark:bg-white/10 border border-white/90 dark:border-white/10 shadow-md flex items-center justify-center relative z-10">
      <IndustryIcon item={item} class={categoryIconColor[color]} />
    </span>
  </span>
  <span class="flex flex-col gap-2 px-4 py-4">
    <span class="text-[15.5px] font-semibold text-foreground">{item.name}</span>
  </span>
</a>
