---
import { Icon } from '@/components/ui/icon';
import type { FundingProduct } from '@/data/funding-products';

interface Props {
  product: FundingProduct;
}

const { product } = Astro.props;

const stats = [
  { icon: 'circle-dollar-sign', label: product.amountLabel, value: product.amount },
  { icon: 'clock',              label: 'Time to Fund',       value: product.timeToFund },
  { icon: 'calendar',           label: 'Loan Terms',         value: product.termLength },
] as const;
---

<section class="bg-secondary w-full py-16">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
    {stats.map(({ icon, label, value }) => (
      <div class="flex items-center gap-4">
        <div class="shrink-0 bg-accent/50 rounded-full p-4 w-16 h-16 flex items-center justify-center">
          <Icon name={icon} class="w-7 h-7 text-accent-foreground" />
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">{label}</p>
          <p class="text-2xl font-bold">{value}</p>
        </div>
      </div>
    ))}
  </div>
</section>
