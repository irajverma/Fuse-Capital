---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import Calculator from '@/components/Calculator.astro';
import IndustryIcon from '@/components/IndustryIcon.astro';
import { getImage } from 'astro:assets';
import { getIndustryImage } from '@/data/industry-images';
import {
  Accordion,
  AccordionItem,
  AccordionTrigger,
  AccordionContent,
} from '@/components/ui/accordion';
import {
  industryCategories,
  categoryIconColor,
  categoryDotColor,
  type Industry,
  type IndustryCategoryColor,
} from '@/data/industries';
import { getIndustryDetails } from '@/data/industry-details';

export async function getStaticPaths() {
  const paths = [];

  // Individual industry item routes
  for (const cat of industryCategories) {
    for (const item of cat.items) {
      paths.push({
        params: { slug: item.slug },
        props: { item, categoryKey: cat.key, color: cat.color },
      });
    }
  }

  // Category alias routes requested by user
  const categoryAliases: { slug: string; name: string; categoryKey: string; color: IndustryCategoryColor; iconItem: Industry }[] = [
    {
      slug: 'hospitality-healthcare',
      name: 'Hospitality & Healthcare',
      categoryKey: 'health',
      color: 'emerald',
      iconItem: { name: 'Hospitality & Healthcare', slug: 'hospitality-healthcare', paths: ['M19 14c1.5-1.5 3-3.2 3-5.5A4.5 4.5 0 0 0 12 5 4.5 4.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z', 'M3.5 12h3l1.5-3 2 5 1.5-3h3'] },
    },
    {
      slug: 'logistics-transportation',
      name: 'Logistics & Transportation',
      categoryKey: 'transport',
      color: 'blue',
      iconItem: { name: 'Logistics & Transportation', slug: 'logistics-transportation', paths: ['M3 7h11v9H3z', 'M14 10h4l3 3v3h-7z'], circles: [{ cx: 7, cy: 18, r: 1.5 }, { cx: 17, cy: 18, r: 1.5 }] },
    },
    {
      slug: 'retail',
      name: 'Retail & E-Commerce',
      categoryKey: 'retail',
      color: 'violet',
      iconItem: { name: 'Retail & E-Commerce', slug: 'retail', paths: ['M5 7h14l-1 13H6z', 'M9 7a3 3 0 0 1 6 0'] },
    },
    {
      slug: 'trades',
      name: 'Construction & Trades',
      categoryKey: 'trades',
      color: 'orange',
      iconItem: { name: 'Construction & Trades', slug: 'trades', paths: ['M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1z', 'M10 10V6a2 2 0 0 1 4 0v4'] },
    },
    {
      slug: 'pro',
      name: 'Professional Services',
      categoryKey: 'pro',
      color: 'indigo',
      iconItem: { name: 'Professional Services', slug: 'pro', paths: ['M12 3v18', 'M7 21h10', 'M5 7h14'] },
    },
  ];

  for (const alias of categoryAliases) {
    paths.push({
      params: { slug: alias.slug },
      props: { item: alias.iconItem, categoryKey: alias.categoryKey, color: alias.color },
    });
  }

  return paths;
}

interface Props {
  item: Industry;
  categoryKey: string;
  color: IndustryCategoryColor;
}

const { item, categoryKey, color } = Astro.props;
const details = getIndustryDetails(item.slug, item.name);

// Related industries in the same category
const currentCat = industryCategories.find((c) => c.key === categoryKey);
const relatedIndustries = (currentCat?.items || []).filter((i) => i.slug !== item.slug).slice(0, 4);

const categoryHero = getIndustryImage(item.slug, categoryKey);
const optimizedHeroBg = await getImage({ src: categoryHero, format: 'webp', width: 2000, quality: 90 });
---

<Layout
  title={`${item.name} Business Funding | Funded Experts`}
  description={details.heroDescription}
>
  <!-- Hero Section -->
  <header
    class="hero-banner relative border-b border-border/60 py-16 sm:py-20 px-6 bg-cover bg-center"
    style={`--hero-img: url('${optimizedHeroBg.src}')`}
  >
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-7 flex flex-col items-start gap-5">
        <div class="text-sm font-semibold tracking-wide text-sky-800 dark:text-sky-400 uppercase">
          {details.heroTagline}
        </div>

        <h1 class="text-3xl sm:text-5xl font-normal tracking-tight leading-tight text-slate-950 dark:text-white">
          {details.heroHeadline}
        </h1>

        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-200 leading-relaxed max-w-2xl font-normal">
          {details.heroDescription}
        </p>

        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button as="a" href="/solutions/apply" class="gap-2 px-6 h-11 text-sm font-medium">
            Apply for {item.name} Funding
          </Button>
          <a
            href="#calculator"
            class="inline-flex items-center gap-1.5 px-4 h-11 rounded-md text-sm font-semibold text-slate-800 hover:text-slate-950 dark:text-slate-200 dark:hover:text-white transition-colors"
          >
            Calculate qualification ↓
          </a>
        </div>
      </div>

      <!-- Hero Program Specification Card -->
      <div class="lg:col-span-5 w-full">
        <div class="bg-card/95 backdrop-blur-xs border border-border p-6 rounded-xl shadow-xs flex flex-col gap-5">
          <div class="flex items-center justify-between pb-4 border-b border-border/60">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center shrink-0 border border-border/50">
                <IndustryIcon item={item} class={categoryIconColor[color]} />
              </div>
              <div>
                <p class="text-sm font-bold text-foreground">{item.name}</p>
                <p class="text-xs text-muted-foreground">National Funding Spec</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-medium text-emerald-600 dark:text-emerald-400">
              Active Underwriting
            </span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="bg-secondary/40 rounded-lg p-3 border border-border/50">
              <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider block">Decision Speed</span>
              <span class="text-base font-mono font-bold text-foreground mt-0.5 block tabular-nums">Same-Day / 24h</span>
            </div>
            <div class="bg-secondary/40 rounded-lg p-3 border border-border/50">
              <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider block">Hard Credit Pull</span>
              <span class="text-base font-mono font-bold text-emerald-600 dark:text-emerald-400 mt-0.5 block">None Required</span>
            </div>
            <div class="bg-secondary/40 rounded-lg p-3 border border-border/50">
              <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider block">Approval Ratio</span>
              <span class="text-base font-mono font-bold text-foreground mt-0.5 block tabular-nums">80%+ Qualified</span>
            </div>
            <div class="bg-secondary/40 rounded-lg p-3 border border-border/50">
              <span class="text-[11px] font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider block">Min. Deposits</span>
              <span class="text-base font-mono font-bold text-foreground mt-0.5 block tabular-nums">$10k / Month</span>
            </div>
          </div>

          <div class="pt-2 text-xs text-muted-foreground text-center border-t border-border/60">
            Decisions based on bank deposit history rather than strict personal credit scores.
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Key Parameters Row -->
  <section class="bg-secondary/40 border-b border-border/60 py-10 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="p-4 bg-card border border-border/70 rounded-xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 block">{details.stat1Label}</span>
        <p class="text-2xl sm:text-3xl font-mono font-bold tracking-tight text-foreground mt-1 tabular-nums">{details.stat1Value}</p>
      </div>
      <div class="p-4 bg-card border border-border/70 rounded-xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 block">{details.stat2Label}</span>
        <p class="text-2xl sm:text-3xl font-mono font-bold tracking-tight text-foreground mt-1 tabular-nums">{details.stat2Value}</p>
      </div>
      <div class="p-4 bg-card border border-border/70 rounded-xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 block">{details.stat3Label}</span>
        <p class="text-2xl sm:text-3xl font-mono font-bold tracking-tight text-foreground mt-1 tabular-nums">{details.stat3Value}</p>
      </div>
      <div class="p-4 bg-card border border-border/70 rounded-xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 block">{details.stat4Label}</span>
        <p class="text-2xl sm:text-3xl font-mono font-bold tracking-tight text-foreground mt-1 tabular-nums">{details.stat4Value}</p>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-16 sm:py-20 px-6 max-w-6xl mx-auto">
    <div class="max-w-3xl mb-12">
      <span class="text-sm font-semibold tracking-wide text-sky-600 dark:text-sky-400 uppercase">Program Overview</span>
      <h2 class="text-2xl sm:text-4xl font-light tracking-tight text-foreground mt-1">
        {details.benefitsTitle}
      </h2>
      <p class="text-muted-foreground mt-2 text-base">
        Capital structures calibrated to your operating realities and revenue cadence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {details.benefits.map((benefit) => (
        <div class="p-6 bg-card border border-border/80 rounded-xl">
          <h3 class="text-base font-semibold text-foreground mb-1">{benefit.title}</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">{benefit.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Calculator Section -->
  <section id="calculator" class="bg-secondary/30 py-16 sm:py-20 px-6 border-y border-border/60">
    <div class="max-w-4xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-sm font-semibold tracking-wide text-sky-600 dark:text-sky-400 uppercase">Qualifications Estimator</span>
        <h2 class="text-2xl sm:text-4xl font-light tracking-tight text-foreground mt-1">
          Estimate capital capacity for {item.name.toLowerCase()}
        </h2>
        <p class="text-muted-foreground mt-2 text-sm sm:text-base">
          Adjust monthly deposit figures to view potential advance amounts and terms.
        </p>
      </div>

      <Calculator />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 sm:py-20 px-6 max-w-4xl mx-auto">
    <div class="mb-10">
      <span class="text-sm font-semibold tracking-wide text-sky-600 dark:text-sky-400 uppercase">Common Questions</span>
      <h2 class="text-2xl sm:text-4xl font-light tracking-tight text-foreground mt-1">
        {item.name} Program Details & FAQ
      </h2>
    </div>

    <Accordion collapsible class="w-full">
      {details.faqs.map((faq, i) => (
        <AccordionItem value={`faq-${i}`}>
          <AccordionTrigger class="text-left text-base font-medium">
            {faq.question}
          </AccordionTrigger>
          <AccordionContent class="text-sm text-muted-foreground leading-relaxed">
            {faq.answer}
          </AccordionContent>
        </AccordionItem>
      ))}
    </Accordion>
  </section>

  <!-- Related Industries -->
  {relatedIndustries.length > 0 && (
    <section class="bg-secondary/20 py-14 px-6 border-t border-border/60">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-lg font-semibold text-foreground">Related Sector Programs</h3>
            <p class="text-xs text-muted-foreground mt-0.5">Explore adjacent business funding paths</p>
          </div>
          <a href="/industries" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
            Browse all programs
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {relatedIndustries.map((rel) => (
            <a
              href={`/industries/${rel.slug}`}
              class="group flex items-center gap-3 p-4 bg-card border border-border/80 rounded-xl no-underline hover:border-primary/40 transition-all"
            >
              <div class="w-9 h-9 rounded-lg bg-secondary flex items-center justify-center shrink-0 border border-border/50">
                <IndustryIcon item={rel} class={categoryIconColor[color]} />
              </div>
              <span class="text-sm font-semibold text-foreground truncate group-hover:text-primary transition-colors">{rel.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom CTA -->
  <section class="bg-primary text-primary-foreground py-16 px-6 text-center">
    <div class="max-w-2xl mx-auto flex flex-col items-center gap-4">
      <h2 class="text-3xl font-light tracking-tight">Ready to finance your {item.name.toLowerCase()} business?</h2>
      <p class="text-primary-foreground/80 text-sm max-w-md">
        Submit basic monthly revenue details for formal underwriting evaluation within 24 hours.
      </p>
      <Button as="a" href="/solutions/apply" variant="secondary" class="mt-2 h-11 px-8 text-sm font-medium">
        Start Application
      </Button>
    </div>
  </section>
</Layout>

