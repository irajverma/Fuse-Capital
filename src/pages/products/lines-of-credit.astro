---
export const prerender = true;
import { Picture, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

import { Button } from '@/components/ui/button';
import { InputGroup, InputGroupAddon, InputGroupInput, InputGroupText } from '@/components/ui/input-group';

import ProductStats from '@/components/ProductStats.astro';
import { fundingProducts } from '@/data/funding-products';
const product = fundingProducts.find(p => p.href === '/products/lines-of-credit')!;

import heroImg from '../../assets/mechanic.webp';
import secondImg from '../../assets/ManWithPaper.jpg';
import gradientImage from '../../assets/gradient.webp';
const optimizedGradient = await getImage({ src: gradientImage, format: 'webp' });

import Calculator from "@/components/Calculator.astro"

import Process from "@/components/Process.astro"
---
<Layout title="Lines of Credit | Funded Experts" description="Explore business lines of credit available through Funded Experts.">
  <main>
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-24 items-center max-w-6xl mx-auto px-6 py-20">
      <div class="flex flex-col gap-6">
        <h1 class="text-4xl font-bold leading-tight">Flexible capital available <i>whenever you need it</i>.</h1>
        <p class="text-lg text-gray-600">Draw funds on demand, repay what you use, and access credit again, all without reapplying.</p>
        <form action="/solutions/apply" method="get" class="flex items-center gap-2">
          <InputGroup class="flex-1">
            <InputGroupAddon align="inline-start">
              <InputGroupText>$</InputGroupText>
            </InputGroupAddon>
            <InputGroupInput type="text" inputmode="numeric" data-format-number name="amount" placeholder="How much money do you need?" class="py-1.5" />
          </InputGroup>
          <Button type="submit" class="hover:cursor-pointer shrink-0">Apply Now</Button>
        </form>
      </div>
      <div class="w-full h-full min-w-0 overflow-hidden">
        <Picture
          src={heroImg}
          alt="Business owner at work"
          class="w-full h-full object-cover rounded-xl"
          widths={[400, 800]}
          formats={['avif', 'webp']}
        />
      </div>
    </section>

    <ProductStats {product} />


    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-24 items-center max-w-6xl mx-auto px-6 py-20">
        <div class="w-full h-full min-w-0 overflow-hidden">
            <Picture
            src={secondImg}
            alt="Business handshake"
            class="w-full h-full object-cover rounded-xl"
            widths={[400, 800]}
            formats={['avif', 'webp']}
            />
        </div>
        <div class="flex flex-col gap-6">
        <h1 class="text-4xl font-bold leading-tight">How do lines of credit work?</h1>
        <p class="text-lg text-gray-600">A business line of credit gives you a pre-approved borrowing limit you can tap at any time. Unlike a term loan, you only draw what you need and only pay interest on that balance. Once you repay, the credit becomes available again, making it ideal for managing cash flow gaps, covering payroll during slow periods, or jumping on a time-sensitive opportunity. Qualification is typically based on credit score, revenue, and time in business.</p>
      </div>
    </section>

    <div class="bg-secondary py-25">
        <h1 class="mb-12 mt-25 text-4xl font-semibold text-center">See how much you can qualify for:</h1>
        <Calculator class="mx-auto w-full max-w-6xl"/>
    </div>

    <div class="text-white py-20 bg-cover bg-center" style={`background-image: url('${optimizedGradient.src}')`}>
        <Process />
    </div>

  </main>

<script>
  function initNumberInputs() {
    document.querySelectorAll<HTMLInputElement>('[data-format-number]').forEach(input => {
      if ((input as any)._numInitialized) return;
      (input as any)._numInitialized = true;
      input.addEventListener('input', () => {
        const cursorFromEnd = input.value.length - (input.selectionEnd ?? input.value.length);
        const raw = input.value.replace(/\D/g, '');
        const formatted = raw ? Number(raw).toLocaleString('en-US') : '';
        input.value = formatted;
        const pos = Math.max(0, formatted.length - cursorFromEnd);
        input.setSelectionRange(pos, pos);
      });
      const form = input.form;
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const url = new URL(form.action, location.origin);
          url.searchParams.set(input.name, input.value.replace(/\D/g, ''));
          location.href = url.toString();
        });
      }
    });
  }
  initNumberInputs();
  document.addEventListener('astro:page-load', initNumberInputs);
</script>
</Layout>
