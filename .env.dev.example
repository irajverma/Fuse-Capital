# Copy to .env.dev (git-ignored); pnpm dev regenerates .dev.vars from it live.
#
# Local dev needs no real secrets: DEV_BYPASS=1 (wrangler.jsonc) makes the Turnstile
# widget auto-verify without loading the challenge and the API stubs skip siteverify,
# so these keys are never actually used. They are Cloudflare's documented always-pass
# TEST keys, kept here so the plumbing works end-to-end; swap in real keys only if you
# need to exercise the real widget.
turnstile_site_key=1x00000000000000000000AA
turnstile_secret_key=1x0000000000000000000000000000000AA
